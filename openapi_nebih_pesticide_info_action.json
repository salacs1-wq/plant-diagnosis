{
  "openapi": "3.1.0",
  "info": {
    "title": "NEBIH pesticide lookup",
    "description": "Use this Action for Hungarian pesticide, dose, crop, pest, disease, weed, active substance, permit and company questions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://nebih-sql-api-production.up.railway.app"
    }
  ],
  "paths": {
    "/action/pesticide-answer": {
      "get": {
        "operationId": "getPesticideInformation",
        "summary": "Lookup NEBIH pesticide data",
        "description": "Call for every pesticide question: dózis, kultúra, károsító, hatóanyag, cég, engedély, ÉVI, BBCH, AKG/AÖP, méhveszély.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "product_name",
            "in": "query",
            "required": false,
            "description": "Plant protection product name, for example Adengo, Racer, Sumi Alfa.",
            "schema": {"type": "string"}
          },
          {
            "name": "active_substance",
            "in": "query",
            "required": false,
            "description": "Active substance name, for example azoxistrobin or deltametrin.",
            "schema": {"type": "string"}
          },
          {
            "name": "permit_number",
            "in": "query",
            "required": false,
            "description": "Authorization or permit number.",
            "schema": {"type": "string"}
          },
          {
            "name": "permit_type",
            "in": "query",
            "required": false,
            "description": "Permit type.",
            "schema": {"type": "string"}
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Company name searched in owner, manufacturer and representative fields.",
            "schema": {"type": "string"}
          },
          {
            "name": "owner",
            "in": "query",
            "required": false,
            "description": "Authorization holder or owner name.",
            "schema": {"type": "string"}
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "description": "Manufacturer name.",
            "schema": {"type": "string"}
          },
          {
            "name": "representative",
            "in": "query",
            "required": false,
            "description": "Hungarian representative name.",
            "schema": {"type": "string"}
          },
          {
            "name": "crop",
            "in": "query",
            "required": false,
            "description": "Crop/culture name, for example kukorica, napraforgó, szója, szőlő, alma.",
            "schema": {"type": "string"}
          },
          {
            "name": "target",
            "in": "query",
            "required": false,
            "description": "Target pest, disease, weed or category.",
            "schema": {"type": "string"}
          },
          {
            "name": "pest_or_disease",
            "in": "query",
            "required": false,
            "description": "Alias for target when the user names a pest or disease.",
            "schema": {"type": "string"}
          },
          {
            "name": "weed",
            "in": "query",
            "required": false,
            "description": "Alias for target when the user names a weed.",
            "schema": {"type": "string"}
          },
          {
            "name": "purpose",
            "in": "query",
            "required": false,
            "description": "Purpose, for example gyomirtó, gombaölő, rovarölő.",
            "schema": {"type": "string"}
          },
          {
            "name": "bbch",
            "in": "query",
            "required": false,
            "description": "Requested BBCH growth stage.",
            "schema": {"type": "string"}
          },
          {
            "name": "phi_days",
            "in": "query",
            "required": false,
            "description": "Requested pre-harvest interval in days.",
            "schema": {"type": "string"}
          },
          {
            "name": "akg_allowed",
            "in": "query",
            "required": false,
            "description": "Filter by AKG permission.",
            "schema": {"type": "boolean"}
          },
          {
            "name": "aop1_bee_allowed",
            "in": "query",
            "required": false,
            "description": "Filter by AÖP bee-related permission.",
            "schema": {"type": "boolean"}
          },
          {
            "name": "organic_allowed",
            "in": "query",
            "required": false,
            "description": "Filter by organic farming permission.",
            "schema": {"type": "boolean"}
          },
          {
            "name": "question_type",
            "in": "query",
            "required": false,
            "description": "Use dose, product, active_substance, usage, phi, documents, recommendation or general.",
            "schema": {
              "type": "string",
              "default": "general"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of returned records.",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact NEBIH pesticide response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "status": {
                      "type": "string",
                      "enum": [
                        "VERIFIED_USAGE",
                        "PRODUCT_ONLY",
                        "POPUP_ONLY",
                        "DOCUMENT_ONLY",
                        "NOT_FOUND",
                        "AMBIGUOUS_LIMITED"
                      ]
                    },
                    "error": {"type": "string"},
                    "query": {
                      "type": "object",
                      "properties": {
                        "product_name": {"type": "string"},
                        "active_substance": {"type": "string"},
                        "permit_number": {"type": "string"},
                        "permit_type": {"type": "string"},
                        "company": {"type": "string"},
                        "owner": {"type": "string"},
                        "manufacturer": {"type": "string"},
                        "representative": {"type": "string"},
                        "crop": {"type": "string"},
                        "target": {"type": "string"},
                        "pest_or_disease": {"type": "string"},
                        "weed": {"type": "string"},
                        "purpose": {"type": "string"},
                        "bbch": {"type": "string"},
                        "phi_days": {"type": "string"},
                        "question_type": {"type": "string"},
                        "query_type": {"type": "string"}
                      },
                      "additionalProperties": true
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {"type": "string"},
                          "product_name": {"type": "string"},
                          "permit_number": {"type": "string"},
                          "permit_type": {"type": "string"},
                          "purpose": {"type": "string"},
                          "owner": {"type": "string"},
                          "manufacturer": {"type": "string"},
                          "representative": {"type": "string"},
                          "expiry_date": {"type": "string"},
                          "akg_allowed": {"type": "boolean"},
                          "aop1_bee_allowed": {"type": "boolean"},
                          "organic_allowed": {"type": "boolean"},
                          "bee_risk": {"type": "string"},
                          "popup_crops": {"type": "array", "items": {"type": "string"}},
                          "popup_targets": {"type": "array", "items": {"type": "string"}},
                          "source_pdf": {"type": "string"}
                        },
                        "additionalProperties": false
                      }
                    },
                    "active_substances": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_name": {"type": "string"},
                          "permit_number": {"type": "string"},
                          "active_substance_name": {"type": "string"},
                          "content": {"type": "string"},
                          "unit": {"type": "string"}
                        },
                        "additionalProperties": false
                      }
                    },
                    "usages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {"type": "string"},
                          "product_name": {"type": "string"},
                          "permit_number": {"type": "string"},
                          "permit_type": {"type": "string"},
                          "crop": {"type": "string"},
                          "target": {"type": "string"},
                          "purpose": {"type": "string"},
                          "dose": {"type": "string"},
                          "dose_unit": {"type": "string"},
                          "bbch": {"type": "string"},
                          "treatment_time": {"type": "string"},
                          "phi": {"type": "string"},
                          "max_treatments": {"type": "string"},
                          "min_interval_days": {"type": "string"},
                          "source_pdf": {"type": "string"}
                        },
                        "additionalProperties": false
                      }
                    },
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_name": {"type": "string"},
                          "permit_number": {"type": "string"},
                          "document_title": {"type": "string"},
                          "document_url": {"type": "string"},
                          "document_date": {"type": "string"},
                          "is_latest_document": {"type": "boolean"}
                        },
                        "additionalProperties": false
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "product_count": {"type": "integer"},
                        "usage_count": {"type": "integer"},
                        "popup_match_count": {"type": "integer"},
                        "active_substance_count": {"type": "integer"},
                        "document_count": {"type": "integer"},
                        "has_more_usage": {"type": "boolean"},
                        "total_usage_matches": {"type": "integer"},
                        "note": {"type": "string"}
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "ok",
                    "status",
                    "query",
                    "products",
                    "active_substances",
                    "usages",
                    "documents",
                    "summary"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
